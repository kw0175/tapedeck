# Downloaded and split audio - never commit these
downloads/
tracks/
*.mp3
*.m4a
*.opus
*.flac
*.wav
*.webm
*.part
*.ytdl
*.jpg
*.png

# Download archives / URL lists are local state
*.archive
done.txt
urls.txt
cookies.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# wrangler local state - caches your account id
.wrangler/
worker/.wrangler/
node_modules/
.dryrun/

# local secrets - never commit
config.local.json

# Personal cuesheets / tracklists for specific recordings - keep them local
*-cue.txt
*-tracklist.txt
!examples/*.example.txt

# Real worker config holds your own KV namespace id; ship the example instead
worker/wrangler.toml

# PyInstaller build output - the exe ships via GitHub Releases, not in git
build/
dist/
*.spec
